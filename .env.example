# ---- data ----
DATASET=dermamnist
NUM_CLASSES=7
IMG_SIZE=224
DATA_ROOT=data

# ---- model ----
BACKBONE=convnext_tiny        # any timm model, e.g. vit_small_patch16_224
PRETRAINED=true
DROPOUT=0.1

# ---- training ----
EPOCHS=15
BATCH_SIZE=64
LR=3e-4
WEIGHT_DECAY=1e-4
USE_CLASS_WEIGHTS=true
LABEL_SMOOTHING=0.1
SEED=42
DEVICE=auto

# ---- artifacts ----
CHECKPOINT_PATH=artifacts/model.pt
ONNX_PATH=artifacts/model.onnx
ONNX_INT8_PATH=artifacts/model.int8.onnx

# ---- experiment tracking ----
USE_WANDB=false
WANDB_PROJECT=medvision
